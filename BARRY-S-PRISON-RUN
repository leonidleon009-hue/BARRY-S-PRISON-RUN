-- // ФУНКЦИЯ АВТО-ПОБЕДЫ (ТЕЛЕПОРТ)
local function autoWinOP()
    local character = player.Character
    if not character then
        warn("[BARRY MENU] Персонаж не найден")
        return
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        warn("[BARRY MENU] HumanoidRootPart не найден")
        return
    end

    -- Телепорт на координаты
    rootPart.CFrame = CFrame.new(AUTO_WIN_POSITION)
    print("[BARRY MENU] Телепорт на Auto Win: " .. tostring(AUTO_WIN_POSITION))
end

-- // ФУНКЦИЯ ПОЛУЧЕНИЯ ВСЕХ ИНСТРУМЕНТОВ
local function getAllTools()
    local ShopAssetsFolder = ReplicatedStorage:WaitForChild("ShopAssetsFolder", 10)
    if not ShopAssetsFolder then
        warn("[BARRY MENU] ShopAssetsFolder не найден")
        return
    end

    local ToolsFolder = ShopAssetsFolder:WaitForChild("ToolsFolder", 5)
    if not ToolsFolder then
        warn("[BARRY MENU] ToolsFolder не найден")
        return
    end

    local Tools = ToolsFolder:WaitForChild("Tools", 5)
    if not Tools then
        warn("[BARRY MENU] Tools не найден")
        return
    end

    local AssetRemotes = ShopAssetsFolder:FindFirstChild("AssetRemotes")
    local SendTool = AssetRemotes and AssetRemotes:FindFirstChild("SendTool")

    if not SendTool then
        warn("[BARRY MENU] SendTool не найден")
        return
    end

    local allTools = {}
    local function collectTools(folder)
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(allTools, item)
            elseif item:IsA("Folder") then
                collectTools(item)
            end
        end
    end
    collectTools(Tools)

    -- Очистка текущих инструментов
    for _, item in ipairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then item:Destroy() end
    end
    if player.Character then
        for _, item in ipairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then item:Destroy() end
        end
    end

    -- Выдача всех инструментов
    local batchSize = 5
    local total = #allTools

    for i = 1, total, batchSize do
        for j = i, math.min(i + batchSize - 1, total) do
            local tool = allTools[j]
            task.spawn(function()
                pcall(function()
                    SendTool:FireServer(tool.Name, true)
                end)
            end)
        end
        task.wait(0.05)
    end

    task.wait(0.5)
    print("[BARRY MENU] Получено инструментов: " .. total)
end

